/** Meliau's 2026 crop history (Yu Chen, 19 Nov 2026: "load this"), loaded once by importMeliau2026() below, so
 *  the estate's own year is in the book before its trial starts (26 Nov). From two papers of HQ's (Wawa):
 *  the FFB delivery book TONNAGE MELU (702 lorries, 4,077.50 MT, 1 Jan - 18 Nov 2026) and the FFB bunches book
 *  SPLT.MELU_FFB_BUNCHES (187,222 bunches, 48 harvesters, 2,378 harvester days, every day adding up to the book's
 *  own day total, every month's MT equal to the delivery book).
 *  No names here. The drivers (D1..) and the harvesters (H1..) are real people, and real worker names never go on
 *  GitHub (19 Oct 2026), so they live only in the office project's own file melu-old-names.gs (MELU_OLD_NAMES_).
 *  Without that file the load refuses and writes nothing. Like the Paitan load of 13 Nov: live sheet only; every
 *  row keyed_by IMPORT and noted "Data lama"; run once from the editor; a second run adds nothing.
 *  A hole beats a guess (18 Nov 2026):
 *   - A lorry's block split is loaded only where the book's own two places agree: the block column and the
 *     tonnes written under blocks 1-6. 148 lorries (947.50 MT) disagree, so they carry no block split, and both
 *     of the book's answers are written in the note, for Wawa to settle. One lorry has no split at all and a
 *     single block in its column: the whole load goes to that block, noted.
 *   - A harvester's bunches carry a block only on a day the bunches book names one block for the estate; on a
 *     day of two or more blocks the block is left blank and the blocks are written in the note.
 *   - A short name in the bunches book is matched to the Meliau worker list only when exactly one worker has that
 *     first name; otherwise the man comes in as "Pekerja lama", active N, not on the muster until HR confirms.
 *  Book errors kept visible, never quietly changed: 7 dates written with the wrong year (06.01.20226, 27.06.2027),
 *  taken from the month sheet; one ticket number (A053408) used twice, the second loaded as "-2". The kind of each
 *  mill or collection centre (mill or cc) is read from its name and noted for HQ to confirm.
 *  Lorry:      MMDD|ticket|mill code|DO|lorry|Dn|first MT|second MT|nett MT|unripe|empty|rotten|block:MT,...|fix
 *              fix: D<date in the book> · T<ticket used twice> · S<one block, no split> · B<block column>/<split>
 *  Harvester:  Hn|MM|day:bunches,...      Day block: MM|day:block,...|day:blocks;...  */
var MELU_MILLS_ = { KMD: ['KLK Meliau Dalam', 'mill'], KDM: ['KLK Dhasar Maju', 'mill'], HC: ['Halus Cahaya', 'cc'],
  TG: ['Tougos', 'cc'], LKS: ['LKS', 'cc'], KLK: ['KLK (buku tidak nyatakan kilang)', 'mill'] };
function importMeliau2026() {
  if (typeof MELU_OLD_NAMES_ === 'undefined' || !MELU_OLD_NAMES_) {
    Logger.log('importMeliau2026: the name file melu-old-names.gs is not in this project');
    return { ok: false, error: 'no_name_file' };
  }
  var was = PRACTICE_, out = null;
  try {
    PRACTICE_ = false; BOOK_ = null; ROWS_MEMO_ = null;
    out = importMeliauInto_(MELU_OLD_, MELU_OLD_NAMES_);
  } finally { PRACTICE_ = was; BOOK_ = null; ROWS_MEMO_ = null; }
  Logger.log('importMeliau2026: ' + JSON.stringify(out) + ' (live sheet only)');
  return out;
}
function importMeliauInto_(data, names) {
  var est = 'MELU', out = { mills: 0, tickets: 0, blocks: 0, work: 0, people: 0, matched: 0, same: 0, matches: [] };
  var miss = [];
  data.tickets.forEach(function (s) { var c = String(s).split('|')[5]; if (!names[c] && miss.indexOf(c) < 0) miss.push(c); });
  data.work.forEach(function (s) { var c = String(s).split('|')[0]; if (!names[c] && miss.indexOf(c) < 0) miss.push(c); });
  if (miss.length) throw new Error('importMeliauInto_: no name for ' + miss.join(', '));
  var ss = book_(), now = Utilities.formatDate(new Date(), 'Asia/Kuala_Lumpur', 'yyyy-MM-dd HH:mm');
  var co = ESTATE_COMPANY[est] || 'SPLT', NOTE = 'Data lama: ';
  function tab_(name) { var sh = roomTab_(ss, name); return { sh: sh, head: sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0], rows: [] }; }
  function add_(t, row) {
    row = Object.assign({ date: now.slice(0, 10), company: co, estate: est, keyed_by: IMPORT_BY, keyed_at: now,
      phone: '', status: 'active', replaces: '', received_at: now }, row);
    t.rows.push(t.head.map(function (c) { return plain(row[c] === undefined ? '' : row[c]); }));
  }
  function flush_(t) { if (t.rows.length) t.sh.getRange(t.sh.getLastRow() + 1, 1, t.rows.length, t.head.length).setValues(t.rows); }
  function txt_(s) { return /^0\d/.test(String(s)) ? "'" + s : String(s); }
  var mt = tab_('LIST_MILLS'), tt = tab_('FH_TICKET'), tb = tab_('FH_TICKET_BLOCK'), wt = tab_('FH_WORK'),
      pt = tab_('LIST_PEOPLE'), wl = tab_('WORKER_LOG');
  var haveM = {}, haveT = {}, haveB = {}, haveW = {}, full = {}, first = {}, taken = {};
  standingRows_('LIST_MILLS', est).forEach(function (r) { haveM[millName_(r.name).toLowerCase()] = true; });
  standingRows_('FH_TICKET', est).forEach(function (r) { haveT[String(r.ticket_no)] = true; });
  standingRows_('FH_TICKET_BLOCK', est).forEach(function (r) { haveB[String(r.ticket_no) + '|' + String(r.block)] = true; });
  standingRows_('FH_WORK', est).forEach(function (r) { haveW[String(r.id)] = true; });
  // Worker codes are unique over every estate, so every code already used anywhere is taken.
  readRows_('LIST_PEOPLE', null).all.forEach(function (r) { taken[String(r.worker_id)] = true; });
  standingRows_('LIST_PEOPLE', est).forEach(function (r) {
    var nm = String(r.name).replace(/\s+/g, ' ').trim().toUpperCase(), code = String(r.worker_id);
    full[nm] = code;
    var w = nm.split(' ')[0]; (first[w] = first[w] || []).push(code);
  });
  function who_(short) {
    var nm = String(short).replace(/\s+/g, ' ').trim().toUpperCase();
    if (full[nm]) return { code: full[nm], how: 'nama penuh' };
    var w = nm.split(' ');
    if (w.length === 1 && first[nm] && first[nm].length === 1) return { code: first[nm][0], how: 'nama pertama, seorang sahaja' };
    return null;
  }
  // ---- mills and collection centres ----
  var codes = {};
  data.tickets.forEach(function (s) { codes[String(s).split('|')[2]] = true; });
  Object.keys(codes).sort().forEach(function (c) {
    var m = MELU_MILLS_[c];
    if (!m || haveM[m[0].toLowerCase()]) return;
    haveM[m[0].toLowerCase()] = true;
    add_(mt, { id: 'ML-' + est + '-OLD-' + c, name: m[0], kind: m[1], location: '', active: 'Y',
      note: NOTE + 'buku hantar BTS 2026; jenis (kilang atau pusat kumpulan) dibaca dari nama, HQ sahkan' });
    out.mills++;
  });
  // ---- lorries and their block split ----
  data.tickets.forEach(function (s) {
    var p = String(s).split('|'), tk = p[1];
    if (haveT[tk]) { out.same++; return; }
    haveT[tk] = true;
    var d = '2026-' + p[0].slice(0, 2) + '-' + p[0].slice(2, 4), m = MELU_MILLS_[p[2]], note = NOTE + 'buku hantar BTS 2026';
    String(p[13] || '').split(';').forEach(function (f) {
      if (f.charAt(0) === 'D') note += '; tarikh dalam buku ' + f.slice(1) + ', diambil ikut helaian bulan';
      if (f.charAt(0) === 'T') note += '; nombor tiket ' + f.slice(1) + ' dipakai dua kali dalam buku, yang kedua ditambah "-2"';
      if (f === 'S') note += '; tiada pecahan tan, satu petak dalam lajur petak: semua tan ke petak itu';
      if (f.charAt(0) === 'B') { var b = f.slice(1).split('/');
        note += '; petak tidak dimuat: lajur petak buku "' + b[0] + '" tidak sama dengan pecahan tan "' + (b[1] || 'tiada') + '"'; }
    });
    add_(tt, { id: 'IMP-' + est + '-TK-' + tk, date: d, ticket_no: txt_(tk), trip: '', mill: m ? m[0] : p[2],
      do_no: txt_(p[3]), lorry: p[4], driver: names[p[5]], time: '',
      first_kg: Math.round(Number(p[6]) * 1000), second_kg: Math.round(Number(p[7]) * 1000), deduct_kg: '',
      nett_kg: Math.round(Number(p[8]) * 1000), nett_mt: Number(p[8]), bunches: '', abw_kg: '',
      lorry_bunches: '', mill_bunches: '', rej_ur: Number(p[9]) || '', rej_emp: Number(p[10]) || '',
      rej_rott: Number(p[11]) || '', rej_mt: '', note: note });
    out.tickets++;
    if (!p[12]) return;
    p[12].split(',').forEach(function (x) {
      var b = x.split(':');
      if (haveB[tk + '|' + b[0]]) return;
      haveB[tk + '|' + b[0]] = true;
      add_(tb, { id: 'IMP-' + est + '-TB-' + tk + '-' + b[0], date: d, ticket_no: txt_(tk), block: b[0], bunches: '', mt: Number(b[1]) });
      out.blocks++;
    });
  });
  // ---- the block of each harvest day, from the bunches book ----
  var dayOne = {}, dayMany = {};
  (data.dayBlock || []).forEach(function (s) {
    var p = String(s).split('|'), mm = p[0];
    String(p[1] || '').split(',').filter(String).forEach(function (x) { var y = x.split(':'); dayOne[mm + ('0' + y[0]).slice(-2)] = y[1]; });
    String(p[2] || '').split(';').filter(String).forEach(function (x) { var y = x.split(':'); dayMany[mm + ('0' + y[0]).slice(-2)] = y[1]; });
  });
  // ---- one row per harvester per day ----
  var seenH = {};
  data.work.forEach(function (s) {
    var p = String(s).split('|'), nm = String(names[p[0]]).replace(/\s+/g, ' ').trim(), w = seenH[p[0]];
    if (!w) {
      w = who_(nm);
      if (w) { out.matched++; out.matches.push(p[0] + '→' + w.code + ' (' + w.how + ')'); }
      else {
        var code = newWorkerCode_(est, taken); taken[code] = true; full[nm.toUpperCase()] = code; w = { code: code, how: 'baru' };
        add_(pt, { id: 'WK-' + est + '-OLD-' + code, worker_id: code, name: nm, job: 'Penuai', gang: 'Tuai', sex: '', mandor: '', active: 'N' });
        add_(wl, { id: 'WL-' + est + '-OLD-' + code, worker_id: code, name: nm, kind: 'new', day: '2026-01-01',
          note: 'Pekerja lama: nama pendek dari buku BTS Meliau 2026, tiada padanan pasti dalam senarai pekerja. Belum pada muster; HR sahkan.' });
        out.people++;
      }
      seenH[p[0]] = w;
    }
    String(p[2]).split(',').forEach(function (x) {
      var y = x.split(':'), dd = ('0' + y[0]).slice(-2), key = p[1] + dd, id = 'IMP-' + est + '-HA-' + w.code + '-' + key;
      if (haveW[id]) { out.same++; return; }
      haveW[id] = true;
      var blk = dayOne[key] || '', note = NOTE + 'buku BTS Meliau 2026';
      note += blk ? '; petak dari baris BLOCK buku (satu petak hari itu)' : dayMany[key] ? '; hari itu petak ' + dayMany[key] + ', petak tiap penuai tidak direkod' : '; petak tidak direkod dalam buku';
      add_(wt, { id: id, date: '2026-' + p[1] + '-' + dd, chit: '', worker_id: w.code, task_code: HARVEST_CODE,
        block: blk, lot: '', qty: '', unit: '', bunches: Number(y[1]), confirmed_by: '', confirmed_at: '',
        bags: '', machine: '', meter_start: '', meter_end: '', hours: '', note: note });
      out.work++;
    });
  });
  [mt, pt, wl, tt, tb, wt].forEach(flush_);
  ROWS_MEMO_ = null;
  return out;
}
